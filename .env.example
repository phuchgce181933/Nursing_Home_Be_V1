# Node environment. Use "local" to read MONGO_URI_LOCAL instead of MONGO_URI (see config/db.js).
NODE_ENV=

# MongoDB — the actual var names read by config/db.js. NODE_ENV=local uses MONGO_URI_LOCAL;
# anything else (including production) uses MONGO_URI.
MONGO_URI=
MONGO_URI_LOCAL=

# JWT
JWT_SECRET=

# Comma-separated list of extra allowed CORS origins beyond the built-in localhost defaults —
# set this to your deployed web app's URL(s), e.g. https://your-app.vercel.app
CORS_ORIGINS=

# Cloudinary — required for image/file uploads. Get these from your own Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Local dev: defaults to true when NODE_ENV=local; set false to enforce TLS verify
CLOUDINARY_INSECURE_SSL=true

# Firebase Realtime Database — emergency readiness sync (optional feature)
FIREBASE_DATABASE_URL=
# Paste full service account JSON as a single line, or use GOOGLE_APPLICATION_CREDENTIALS instead
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=./config/firebase-service-account.json
READINESS_SYNC_ENABLED=true

# PayOS payment integration — get these from your own PayOS merchant dashboard.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_SECRET=
# Must be a publicly reachable URL for PayOS callbacks / checkout redirects. Do not use localhost.
PAYOS_CHECKOUT_URL=

# TextBee SMS gateway — required for OTP over SMS (wallet payment, phone verification).
# Get these from your own TextBee dashboard (https://textbee.dev): the API key and the id of
# the paired Android gateway device. Without both, sendTextBeeSms() fails loudly instead of
# pretending the SMS was sent. Recipients are normalised to international format (+84…).
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Optional override, defaults to https://api.textbee.dev
TEXTBEE_BASE_URL=
