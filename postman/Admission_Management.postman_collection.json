{
  "info": {
    "name": "Nursing Home - Admission Management",
    "_postman_id": "admission-mgmt-collection-v1",
    "description": "Collection test API Quản lý yêu cầu nhập viện\n\n**Bước 1:** Chạy request \"Login (Family)\" hoặc \"Login (Admin)\" → token tự động lưu vào biến collection\n**Bước 2:** Dùng các request còn lại bình thường\n\nPassword mặc định: `password123`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "familyToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "admissionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Login (Family)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('familyToken', json.token);",
                  "  console.log('✅ familyToken saved:', json.token.slice(0, 30) + '...');",
                  "} else {",
                  "  console.log('❌ Login failed:', JSON.stringify(json));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"family@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('adminToken', json.token);",
                  "  console.log('✅ adminToken saved:', json.token.slice(0, 30) + '...');",
                  "} else {",
                  "  console.log('❌ Login failed:', JSON.stringify(json));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "👨‍👩‍👧 Family - Admission Requests",
      "item": [
        {
          "name": "1. Submit Admission Request (new applicant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.admission && json.admission._id) {",
                  "  pm.collectionVariables.set('admissionId', json.admission._id);",
                  "  console.log('✅ admissionId saved:', json.admission._id);",
                  "  console.log('requestCode:', json.admission.requestCode);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{familyToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicant\": {\n    \"fullName\": \"Nguyễn Văn Bình\",\n    \"dateOfBirth\": \"1948-05-20\",\n    \"gender\": \"male\",\n    \"citizenId\": \"012345678901\",\n    \"bloodType\": \"B+\",\n    \"personalAddress\": \"123 Đường Lê Lợi, TP.HCM\",\n    \"relationshipToRequester\": \"Cha\",\n    \"allergies\": [\"Aspirin\"],\n    \"chronicConditions\": [\"Huyết áp cao\", \"Tiểu đường type 2\"],\n    \"initialHealthCondition\": \"Sức khoẻ yếu, cần chăm sóc thường xuyên\"\n  },\n  \"preferredAdmissionDate\": \"2026-06-01\",\n  \"reasonForAdmission\": \"Người cao tuổi sống một mình, cần được chăm sóc y tế 24/7\",\n  \"requestedByPhone\": \"0901234567\",\n  \"notes\": \"Ưu tiên phòng tầng 1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/family/admission-requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "family", "admission-requests"]
            }
          }
        },
        {
          "name": "2. List Admission Requests (all)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{familyToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/family/admission-requests?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "family", "admission-requests"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "2b. List Admission Requests (filter by status)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{familyToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/family/admission-requests?status=new_request",
              "host": ["{{baseUrl}}"],
              "path": ["api", "family", "admission-requests"],
              "query": [
                { "key": "status", "value": "new_request" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "from", "value": "2026-01-01", "disabled": true },
                { "key": "to", "value": "2026-12-31", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "3. Get Admission Request Detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{familyToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/family/admission-requests/{{admissionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "family", "admission-requests", "{{admissionId}}"]
            }
          }
        },
        {
          "name": "4. Cancel Admission Request",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{familyToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancellationReason\": \"Gia đình đã thu xếp người chăm sóc tại nhà\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/family/admission-requests/{{admissionId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "family", "admission-requests", "{{admissionId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "🛡️ Admin - Admission Management",
      "item": [
        {
          "name": "1. List All Admission Requests",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/admission-requests?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "admission-requests"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "new_request", "disabled": true },
                { "key": "eligibilityStatus", "value": "pending", "disabled": true },
                { "key": "search", "value": "Bình", "disabled": true },
                { "key": "from", "value": "2026-01-01", "disabled": true },
                { "key": "to", "value": "2026-12-31", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "2. Get Admission Request Detail (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/admission-requests/{{admissionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "admission-requests", "{{admissionId}}"]
            }
          }
        },
        {
          "name": "3. Approve Admission Request",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignedServicePackage\": \"Gói chăm sóc cơ bản\",\n  \"notes\": \"Hồ sơ đã đủ điều kiện, chuyển sang ký hợp đồng\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/admission-requests/{{admissionId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "admission-requests", "{{admissionId}}", "approve"]
            }
          }
        },
        {
          "name": "4. Reject Admission Request (with reason)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"Cơ sở hiện không còn phòng trống phù hợp với nhu cầu của người cao tuổi\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/admission-requests/{{admissionId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "admission-requests", "{{admissionId}}", "reject"]
            }
          }
        }
      ]
    },
    {
      "name": "⚠️ Error Cases",
      "item": [
        {
          "name": "Submit - Missing applicant.fullName",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{familyToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicant\": {\n    \"relationshipToRequester\": \"Mẹ\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/family/admission-requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "family", "admission-requests"]
            }
          }
        },
        {
          "name": "Reject - Missing rejectionReason",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/admission-requests/{{admissionId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "admission-requests", "{{admissionId}}", "reject"]
            }
          }
        },
        {
          "name": "Get Detail - Invalid ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/admission-requests/000000000000000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "admission-requests", "000000000000000000000000"]
            }
          }
        },
        {
          "name": "Access Admin route with Family token (403)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{familyToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/admission-requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "admission-requests"]
            }
          }
        }
      ]
    }
  ]
}
