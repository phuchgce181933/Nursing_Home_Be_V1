# MongoDB
MONGODB_URI=

# JWT
JWT_SECRET=

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Realtime Database — emergency readiness sync
FIREBASE_DATABASE_URL=https://nursing-home-53472-default-rtdb.asia-southeast1.firebasedatabase.app
# Paste full service account JSON as a single line, or use GOOGLE_APPLICATION_CREDENTIALS instead
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=./config/firebase-service-account.json
READINESS_SYNC_ENABLED=true
